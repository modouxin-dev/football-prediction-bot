# Telegram Bot
TELEGRAM_TOKEN=your_telegram_bot_token_here

# RapidAPI Football API
RAPID_API_KEY=your_rapidapi_key_here

# Football League Configuration
LEAGUE_ID=39  # 39=英超, 140=西甲, 135=意甲, 78=德甲, 61=法甲
SEASON=2024

# Telegram Chat Configuration
CHAT_ID=your_chat_id_here

# Timezone (for scheduled predictions)
TIMEZONE=UTC
# 其他时区示例: Asia/Shanghai, Europe/London, America/New_York

# Optional: Logging Level
LOG_LEVEL=INFO

