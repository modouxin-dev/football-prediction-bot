# ===== 必填 =====
# 从 @BotFather 获取
TELEGRAM_TOKEN=
# 接收推送的聊天 ID：私聊填你自己的用户 ID，群组是负数，频道可填 @频道名
CHAT_ID=

# 数据源 Key，二选一：
# 1) RapidAPI 上订阅 API-Football 后得到的 Key
RAPID_API_KEY=
# 2) 官方直连（dashboard.api-football.com 注册）。设置后优先使用它
# API_FOOTBALL_KEY=

# ===== 可选 =====
# 管理员的 Telegram 用户 ID，多个用逗号分隔。不填时，若 CHAT_ID 是私聊 ID 则默认它就是管理员
# 在机器人里点 /test，如果提示无权限，回复里会显示你的用户 ID
ADMIN_ID=
# 联赛 ID：39 英超 / 140 西甲 / 135 意甲 / 78 德甲 / 61 法甲 / 2 欧冠
LEAGUE_ID=39
# 赛季（按开赛年份，2026-27 赛季填 2026）。填过期的年份时，机器人会在无赛程时自动改用按日期推算的赛季
SEASON=2026
# 每日推送时间（24 小时制）和时区
PUSH_TIME=08:00
TIMEZONE=Asia/Shanghai
# 每次最多推送几场；只推送未来多少小时内开赛的比赛
MAX_MATCHES=3
LOOKAHEAD_HOURS=36
LOG_LEVEL=INFO

# ===== 赛季策略 =====
# 期望的赛季（按开赛年份）。留空则用 SEASON
REQUESTED_SEASON=2026
# auto = 自动识别可用赛季并在不可用时降级；fixed = 只用目标赛季，不降级
SEASON_MODE=auto
# 是否允许赛季降级（目标赛季不可用时自动切换到最近可用赛季）
ALLOW_SEASON_FALLBACK=true

# ===== 备用数据源 football-data.org（免费，主源不可用时接管赛程/赛果/积分榜）=====
# 注册地址：https://www.football-data.org/client/register （Token 会发送到邮箱）
# 未配置时备用源自动禁用，不影响主源功能
FOOTBALL_DATA_API_TOKEN=
# 自建代理 / 测试时可覆盖；留空则用官方地址
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_ENABLED=true
FOOTBALL_DATA_TIMEOUT=10
# auto = 主源优先，失败自动切备用源；api-football = 只用主源；football-data = 只用备用源
DATA_SOURCE_MODE=auto

# ---- 存储（必须挂 Volume / 持久卷，否则重新部署会丢）----
# Railway：新建 Volume，挂载路径填 /data。
# 自托管（docker-compose）：对应 ./data:/data，无需改动下面的值。
# Fly.io：对应 fly.toml 里的 [[mounts]] destination = "/data"。
DATA_DIR=/data
DATABASE_PATH=/data/football.db
# 兼容旧写法：config.py 也接受 DB_PATH，与 DATABASE_PATH 等价
# DB_PATH=/data/football.db
CACHE_DIR=/data/cache
CHART_DIR=/data/charts
# 图表默认只在内存生成（不落盘、不堆积）；设为 true 才保存 PNG 到 CHART_DIR
SAVE_CHARTS=false
